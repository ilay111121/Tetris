[app]
title = Tetris
package.name = tetris
package.domain = org.example
source.dir = .
source.include_exts = py,png,jpg,kv
version = 1.0
requirements = python3,pygame
orientation = portrait
fullscreen = 1
android.archs = arm64-v8a, armeabi-v7a
android.minapi = 23
android.api = 35

[buildozer]
log_level = 2
warn_on_root = 1
